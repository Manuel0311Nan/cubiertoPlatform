{
  "name": "@cubierto/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "build": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "migrate:dev": "prisma migrate dev && prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:test": "prisma migrate deploy --config prisma.test.config.ts",
    "migrate:status": "prisma migrate status",
    "seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
