# Copia este archivo como `.env` en la raíz del repo y rellénalo. `.env` está en .gitignore.
# Lista completa y fase de cada variable: specs/00-necesidades.md §5.

PLATFORM_DOMAIN=localhost

# Neon, rama `dev` (Connect → Pooled connection / Direct connection)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon, rama `test`: solo para `pnpm test` (los tests crean y borran sus datos). Conexión directa.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Better Auth (PLT-02). Secreto: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# La URL es la de app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://app.localhost:3000

# Resend. Vacío en local: los emails (y el enlace de entrada) salen en la consola de `pnpm dev`.
RESEND_API_KEY=
EMAIL_FROM=Cubierto <hola@cubierto.site>

# Protege /api/cron/* (Vercel Cron lo manda como Authorization: Bearer …)
CRON_SECRET=

# Email del superadmin que crea `pnpm db:seed` (por defecto superadmin@cubierto.test)
SEED_SUPERADMIN_EMAIL=
